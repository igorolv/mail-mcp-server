<?xml version="1.0" encoding="UTF-8"?>
<!-- Logging for user-run commands, which run without Spring.
     stdout carries the command report; diagnostics go to stderr. -->
<configuration>
    <appender name="STDERR" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.err</target>
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %5p %-30.30logger{29} : %m%n</pattern>
        </encoder>
    </appender>

    <root level="WARN">
        <appender-ref ref="STDERR"/>
    </root>

    <!-- Header and wire logs carry NTLM/Basic Authorization headers and mail content. -->
    <logger name="org.apache.hc.client5.http.headers" level="OFF"/>
    <logger name="org.apache.hc.client5.http.wire" level="OFF"/>
    <logger name="org.eclipse.angus.mail" level="OFF"/>
    <logger name="jakarta.mail" level="OFF"/>
    <!-- Damaged but readable PDFs produce warnings; their text is still extracted. -->
    <logger name="org.apache.pdfbox" level="ERROR"/>
    <logger name="org.apache.fontbox" level="ERROR"/>
    <!-- Damaged Word 97-2003 and Visio files produce warnings, and unsupported Word fields such as
         PAGE produce warnings that quote document text; the text is still extracted. -->
    <logger name="org.apache.poi.hwpf" level="ERROR"/>
    <logger name="org.apache.poi.hdgf" level="ERROR"/>
    <!-- Office 97-2003 files without the optional document summary stream, common in generated
         XLS/DOC files; the text is still extracted. -->
    <logger name="org.apache.poi.POIDocument" level="ERROR"/>
    <!-- MSG files carry attachment chunk properties POI does not support; the message is still parsed. -->
    <logger name="org.apache.poi.hsmf" level="ERROR"/>
    <!-- Some XLSX writers store hyperlinks as mailto:<address>, which is not a valid URI; POI logs the
         address at error level and substitutes a dummy relationship, and the cell text is still
         extracted. This class logs nothing else. -->
    <logger name="org.apache.poi.openxml4j.opc.PackageRelationshipCollection" level="OFF"/>
</configuration>
